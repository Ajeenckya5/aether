<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ink">

  <WebView
    android:id="@+id/web"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <LinearLayout
    android:id="@+id/picker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Connect WHOOP"
      android:textColor="#f4f1ea"
      android:textSize="22sp" />

    <TextView
      android:id="@+id/empty_scan"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="Wear the WHOOP, wake it, and disconnect the official WHOOP app. Scanning for public Heart Rate straps…"
      android:textColor="#9a958c"
      android:textSize="14sp" />

    <ListView
      android:id="@+id/hits"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="8dp" />

    <Button
      android:id="@+id/cancel_pick"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Cancel" />
  </LinearLayout>
</FrameLayout>
