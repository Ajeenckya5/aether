/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), geolocation=(self), bluetooth=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geocoding-api.open-meteo.com https://api.bigdatacloud.net; manifest-src 'self'; worker-src 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: no-cache

/*.png
  Content-Type: image/png

/*.svg
  Content-Type: image/svg+xml

/*.webm
  Content-Type: video/webm
