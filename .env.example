WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Weather, AQI, UV, elevation, and city search use Open-Meteo (no key).
# Approximate location uses ipwho.is in the browser (no key).
# Coach movement cards use wger.de (no key).

# Canonical download is GitHub. Play / App Store URLs are optional and stay
# empty until those listings exist — the in-app Download page then still
# sends iPhone and Android users to GitHub.
NEXT_PUBLIC_GITHUB_OWNER=Ajeenckya5
NEXT_PUBLIC_GITHUB_REPO=aether
NEXT_PUBLIC_GITHUB_BRANCH=master
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
